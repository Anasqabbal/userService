{
  "compilerOptions": {
    "target"         : "ES2020",
    "module"         : "commonjs",
    "lib"            : ["ES2020"],
    "rootDir"        : ".",
    "outDir"         : "dist",
    "strict"         : true,
    "esModuleInterop": true,
    "skipLibCheck"   : true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
