# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── App ──────────────────────────────
NODE_ENV=development
PORT=3000

# ─── MySQL ────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=userservicedb

# ─── MySQL (Docker) ───────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=userservicedb
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_PORT=3306
